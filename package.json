{
  "name": "syscor-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm start --workspace @syscor/app-customer",
    "employee": "npm start --workspace @syscor/app-employee",
    "customer:android": "npm run android --workspace @syscor/app-customer",
    "employee:android": "npm run android --workspace @syscor/app-employee"
  }
}
