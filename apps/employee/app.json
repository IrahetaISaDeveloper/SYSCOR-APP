{
  "expo": {
    "name": "SYSCOR - Staff",
    "slug": "syscor-app-empleados",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-el-corral.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "El Corral Staff usa tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": "El Corral Staff usa la cámara para que te tomes tu foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "El Corral Staff usa tu ubicación para trazar la ruta hasta el domicilio del cliente."
        }
      ],
      "@rnmapbox/maps"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syscor.empleados"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.syscor.empleados",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/492e633a-5326-4ac5-8120-c74dd39d2735"
    },
    "owner": "syscors-team",
    "extra": {
      "eas": {
        "projectId": "492e633a-5326-4ac5-8120-c74dd39d2735"
      }
    }
  }
}
