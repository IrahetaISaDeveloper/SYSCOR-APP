{
  "expo": {
    "name": "El Corral",
    "slug": "syscor-app-clientes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-horizontal-negro.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F1",
          "dark": {
            "image": "./assets/logo-horizontal-blanco.png",
            "backgroundColor": "#0E0E0E"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syscor.clientes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.syscor.clientes"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
